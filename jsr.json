{
  "name": "@alanrsoares/preludejs",
  "version": "1.2.0",
  "description": "A modular, tree-shaking friendly implementation of Haskell's Prelude library in modern, type-safe JavaScript.",
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "src/**/*.js",
      "src/**/*.d.ts"
    ]
  },
  "exports": {
    ".": "./src/index.d.ts",
    "./Func": "./src/Func/index.d.ts",
    "./General": "./src/General/index.d.ts",
    "./List": "./src/List/index.d.ts",
    "./Num": "./src/Num/index.d.ts",
    "./Obj": "./src/Obj/index.d.ts",
    "./Str": "./src/Str/index.d.ts"
  }
}
