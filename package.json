{
  "name": "preludejs",
  "version": "1.2.1",
  "description": "A modular implementation of Haskell's Prelude library in ES6",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./Func": {
      "types": "./src/Func/index.ts",
      "default": "./src/Func/index.ts"
    },
    "./Func/*": "./src/Func/*.ts",
    "./General": {
      "types": "./src/General/index.d.ts",
      "default": "./src/General/index.js"
    },
    "./General/*": "./src/General/*.js",
    "./List": {
      "types": "./src/List/index.d.ts",
      "default": "./src/List/index.js"
    },
    "./List/*": "./src/List/*.js",
    "./Num": {
      "types": "./src/Num/index.d.ts",
      "default": "./src/Num/index.js"
    },
    "./Num/*": "./src/Num/*.js",
    "./Obj": {
      "types": "./src/Obj/index.d.ts",
      "default": "./src/Obj/index.js"
    },
    "./Obj/*": "./src/Obj/*.js",
    "./Str": {
      "types": "./src/Str/index.d.ts",
      "default": "./src/Str/index.js"
    },
    "./Str/*": "./src/Str/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "build": "tsdown",
    "docs:dev": "bun run --filter 'prelude-docs' dev",
    "docs:build": "bun run --filter 'prelude-docs' build",
    "docs:generate": "bun run scripts/generate-api-docs.ts",
    "generate": "bun scripts/generate-function.js",
    "generate:function": "bun scripts/generate-function.js",
    "generate:indexes": "bun scripts/generate-indexes.js",
    "format": "bunx biome format . --write",
    "format:check": "bunx biome format .",
    "typecheck": "tsc -p tsconfig.types.json --noEmit",
    "jsr:check": "npx jsr publish --dry-run",
    "lint": "bunx biome lint .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepack": "bun run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanrsoares/prelude-js.git"
  },
  "keywords": [
    "prelude",
    "functional",
    "js",
    "es6",
    "haskell",
    "lodash",
    "underscore"
  ],
  "author": "github.com/alanrsoares",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alanrsoares/prelude-js/issues"
  },
  "homepage": "https://alanrsoares.github.io/prelude-js",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.13",
    "deep-freeze": "^0.0.1",
    "fumadocs-twoslash": "^3.2.0",
    "ts-expect": "^1.3.0",
    "tsdown": "^0.22.3",
    "twoslash": "^0.3.8",
    "typescript": "^6.0.3"
  }
}
