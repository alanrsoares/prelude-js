{
  "name": "preludejs",
  "version": "1.2.1",
  "description": "A modular implementation of Haskell's Prelude library in ES6",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./Func": {
      "bun": "./src/Func/index.ts",
      "types": "./dist/Func/index.d.ts",
      "import": "./dist/Func/index.js",
      "require": "./dist/Func/index.cjs"
    },
    "./Func/*": {
      "bun": "./src/Func/*.ts",
      "types": "./dist/Func/*.d.ts",
      "import": "./dist/Func/*.js",
      "require": "./dist/Func/*.cjs"
    },
    "./General": {
      "bun": "./src/General/index.ts",
      "types": "./dist/General/index.d.ts",
      "import": "./dist/General/index.js",
      "require": "./dist/General/index.cjs"
    },
    "./General/*": {
      "bun": "./src/General/*.ts",
      "types": "./dist/General/*.d.ts",
      "import": "./dist/General/*.js",
      "require": "./dist/General/*.cjs"
    },
    "./List": {
      "bun": "./src/List/index.ts",
      "types": "./dist/List/index.d.ts",
      "import": "./dist/List/index.js",
      "require": "./dist/List/index.cjs"
    },
    "./List/*": {
      "bun": "./src/List/*.ts",
      "types": "./dist/List/*.d.ts",
      "import": "./dist/List/*.js",
      "require": "./dist/List/*.cjs"
    },
    "./Num": {
      "bun": "./src/Num/index.ts",
      "types": "./dist/Num/index.d.ts",
      "import": "./dist/Num/index.js",
      "require": "./dist/Num/index.cjs"
    },
    "./Num/*": {
      "bun": "./src/Num/*.ts",
      "types": "./dist/Num/*.d.ts",
      "import": "./dist/Num/*.js",
      "require": "./dist/Num/*.cjs"
    },
    "./Obj": {
      "bun": "./src/Obj/index.ts",
      "types": "./dist/Obj/index.d.ts",
      "import": "./dist/Obj/index.js",
      "require": "./dist/Obj/index.cjs"
    },
    "./Obj/*": {
      "bun": "./src/Obj/*.ts",
      "types": "./dist/Obj/*.d.ts",
      "import": "./dist/Obj/*.js",
      "require": "./dist/Obj/*.cjs"
    },
    "./Str": {
      "bun": "./src/Str/index.ts",
      "types": "./dist/Str/index.d.ts",
      "import": "./dist/Str/index.js",
      "require": "./dist/Str/index.cjs"
    },
    "./Str/*": {
      "bun": "./src/Str/*.ts",
      "types": "./dist/Str/*.d.ts",
      "import": "./dist/Str/*.js",
      "require": "./dist/Str/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "build": "tsdown",
    "docs:dev": "bun run --filter 'prelude-docs' dev",
    "docs:build": "bun run --filter 'prelude-docs' build",
    "docs:generate": "bun run scripts/generate-api-docs.ts",
    "check:examples": "bun run scripts/check-examples.ts",
    "format": "bunx biome check . --write",
    "format:check": "bunx biome check .",
    "typecheck": "tsc -p tsconfig.types.json --noEmit",
    "jsr:check": "npx jsr publish --dry-run",
    "lint": "bunx biome lint .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:examples && bun run test",
    "prepack": "bun run check && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanrsoares/prelude-js.git"
  },
  "keywords": [
    "prelude",
    "functional",
    "js",
    "es6",
    "haskell",
    "lodash",
    "underscore"
  ],
  "author": "github.com/alanrsoares",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alanrsoares/prelude-js/issues"
  },
  "homepage": "https://alanrsoares.github.io/prelude-js",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@onrails/docgen": "1.0.1",
    "@onrails/result": "^0.2.0",
    "@types/bun": "^1.3.13",
    "deep-freeze": "^0.0.1",
    "fumadocs-twoslash": "^3.2.0",
    "ts-expect": "^1.3.0",
    "tsdown": "^0.22.3",
    "twoslash": "^0.3.8",
    "typescript": "^6.0.3"
  }
}
