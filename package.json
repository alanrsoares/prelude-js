{
  "name": "preludejs",
  "version": "1.1.2",
  "description": "A modular implementation of Haskell's Prelude library in ES6",
  "main": "./src/index.js",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "exports": {
    ".": "./src/index.js",
    "./Func": "./src/Func/index.js",
    "./Func/*": "./src/Func/*.js",
    "./General": "./src/General/index.js",
    "./General/*": "./src/General/*.js",
    "./List": "./src/List/index.js",
    "./List/*": "./src/List/*.js",
    "./Num": "./src/Num/index.js",
    "./Num/*": "./src/Num/*.js",
    "./Obj": "./src/Obj/index.js",
    "./Obj/*": "./src/Obj/*.js",
    "./Str": "./src/Str/index.js",
    "./Str/*": "./src/Str/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "docs": "bun scripts/build-readme.js > docs/README.md",
    "generate": "plop",
    "generate:function": "bun scripts/generate-function.js",
    "format": "bunx biome format . --write",
    "format:check": "bunx biome format .",
    "jsr:check": "npx jsr publish --dry-run",
    "lint": "bunx biome lint .",
    "check": "bun run format:check && bun run lint && bun run test",
    "prepack": "bun run check && bun run docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanrsoares/prelude-js.git"
  },
  "keywords": [
    "prelude",
    "functional",
    "js",
    "es6",
    "haskell",
    "lodash",
    "underscore"
  ],
  "author": "github.com/alanrsoares",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alanrsoares/prelude-js/issues"
  },
  "homepage": "https://github.com/alanrsoares/prelude-js#readme",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "deep-freeze": "^0.0.1",
    "plop": "^4.0.1"
  }
}
