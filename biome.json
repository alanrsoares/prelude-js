{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/jsr.json",
      "!**/package.json",
      "!**/docs/**/*.md",
      "!**/coverage",
      "!**/dist",
      "!**/node_modules",
      "!**/apps/docs/.next",
      "!**/apps/docs/out",
      "!**/apps/docs/.source",
      "!**/apps/docs/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off",
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noConsole": "off"
      },
      "style": {
        "noParameterAssign": "off",
        "useExponentiationOperator": "off"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  }
}
