{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun-types"]
  },
  "include": ["src/**/*.d.ts", "test/**/*.test.ts"]
}
